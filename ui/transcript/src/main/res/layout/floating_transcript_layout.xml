<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <de.danoeh.antennapod.ui.transcript.ScrollTextView
        android:id="@+id/tv_floating_transcript"
        android:layout_width="match_parent"
        android:layout_height="@dimen/floating_transcript_height"
        android:background="@android:color/transparent"
        android:textColor="@color/floating_transcript_text"
        android:textSize="@dimen/floating_transcript_text_size"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/floating_transcript_padding_horizontal"
        android:paddingVertical="0dp"
        android:singleLine="true"
        android:ellipsize="none"
        android:shadowColor="@color/floating_transcript_shadow"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:visibility="invisible" />
</FrameLayout>
