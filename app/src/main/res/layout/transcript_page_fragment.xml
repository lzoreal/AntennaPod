<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/controlsBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnOffsetToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/transcript_offset_toggle_description"
            android:src="@drawable/ic_transcript_offset" />

        <ImageButton
            android:id="@+id/btnTranslationToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toggle_translation"
            android:src="@drawable/ic_transcript_translate"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnLineBreakToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/transcript_line_break_description"
            android:src="@drawable/ic_transcript_linebreak" />

        <TextView
            android:id="@+id/btnLayout"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/transcript_layout_toggle_description"
            android:gravity="center"
            android:text="@string/transcript_layout_toggle"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnSegmentLoop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/transcript_segment_loop_description"
            android:src="@drawable/ic_transcript_loop" />

        <ImageButton
            android:id="@+id/btnImmersive"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingEnd="13dp"
            android:contentDescription="@string/immersive_mode"
            android:src="@drawable/ic_fullscreen" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progLoading"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_transcript_label"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnBackToCurrent"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_transcript_offset_button"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/transcript_back_to_current"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/offsetControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnOffsetBack05"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtOffsetValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnOffsetForward05"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnOffsetBack30"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnOffsetBack10"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnOffsetBack5"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnOffsetForward5"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnOffsetForward10"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnOffsetForward30"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/transcript_layout_font_size"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnFontSizeDown"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:text="@string/transcript_layout_decrease_symbol"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtFontSizeValue"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnFontSizeUp"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:text="@string/transcript_layout_increase_symbol"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/transcript_layout_line_spacing"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnLineSpacingDown"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:text="@string/transcript_layout_decrease_symbol"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtLineSpacingValue"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnLineSpacingUp"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:text="@string/transcript_layout_increase_symbol"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/transcript_layout_side_margins"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSideMarginsDown"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:text="@string/transcript_layout_decrease_symbol"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtSideMarginsValue"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnSideMarginsUp"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:text="@string/transcript_layout_increase_symbol"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/transcript_layout_vertical_spacing"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnVerticalSpacingDown"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:text="@string/transcript_layout_decrease_symbol"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtVerticalSpacingValue"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnVerticalSpacingUp"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_transcript_offset_button"
                android:gravity="center"
                android:text="@string/transcript_layout_increase_symbol"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnLayoutReset"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_transcript_offset_button"
            android:gravity="center"
            android:text="@string/reset"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
